# ============================================================
# .dockerignore
# Исключения при копировании контекста в Docker-образ
# ============================================================

# Артефакты сборки рабочего пространства
build/
devel/
install/
logs/

# История git (большой размер, не нужна в образе)
.git/
.gitignore

# Python кэш
*.pyc
*.pyo
__pycache__/
*.egg-info/

# Логи
*.log
.roslaunch/
.rosinstall

# Виртуальные окружения
.venv/
venv/

# IDE и редакторы
.vscode/
.idea/
*.swp
*.swo

# Скриншоты и отчёты (не нужны в образе)
*.png
*.jpg
*.jpeg
*.docx
*.pdf

# Docker файлы (не нужно копировать их сами в образ)
docker/
Dockerfile
.dockerignore

# Временные файлы
.tmp/
temp/
*.bak

# Скриншоты проверки
rviz&rqt.png
