# ============================================================
# .dockerignore
# Исключения при копировании контекста в Docker-образ
# ============================================================

# Артефакты сборки рабочего пространства (важно!)
build/
devel/
install/
logs/

# История git (большой размер, не нужна в образе)
.git/
.gitignore

# Python кэш
*.pyc
*.pyo
__pycache__/
*.egg-info/

# Логи ROS
*.log
.roslaunch/
.rosinstall

# Виртуальные окружения
.venv/
venv/

# IDE и редакторы
.vscode/
.idea/
*.swp
*.swo

# Скриншоты и отчёты (не нужны в образе)
*.png
*.jpg
*.jpeg
*.docx
*.pdf

# Docker файлы (САМИ Dockerfile и .dockerignore исключаются,
# но папка docker/ с entrypoint.sh и sshd_config ДОЛЖНА остаться)
Dockerfile
.dockerignore
docker/Dockerfile
docker/.dockerignore

# Временные файлы
.tmp/
temp/
*.bak
