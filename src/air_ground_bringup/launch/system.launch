<?xml version="1.0"?>
<!-- ============================================================ -->
<!-- system.launch                                                 -->
<!-- Главный launch-файл системы охраны воздушного пространства    -->
<!-- Проект: Air-Ground Security System — MVP (Фаза 1)             -->
<!-- ============================================================ -->
<!--                                                               -->
<!-- Запуск системы:                                               -->
<!--   roslaunch air_ground_bringup system.launch                  -->
<!--                                                               -->
<!-- Запуск с визуализацией в RViz:                                -->
<!--   roslaunch air_ground_bringup system.launch rviz:=true       -->
<!--                                                               -->
<!-- Запуск с визуализацией в RQT:                                 -->
<!--   roslaunch air_ground_bringup system.launch rqt:=true        -->
<!--                                                               -->
<!-- Запуск со всей визуализацией:                                 -->
<!--   roslaunch air_ground_bringup system.launch rviz:=true rqt:=true -->
<!--                                                               -->
<!-- ============================================================ -->

<launch>

  <!-- ============================================================ -->
  <!-- АРГУМЕНТЫ ЗАПУСКА                                             -->
  <!-- ============================================================ -->

  <!-- Визуализация (требуется по заданию курсовой) -->
  <arg name="rviz" default="false" doc="Запустить RViz для визуализации"/>
  <arg name="rqt" default="false" doc="Запустить RQT для мониторинга топиков"/>

  <!-- Режимы симуляции (Фаза 1) -->
  <arg name="simulate_intruder" default="true" doc="Запустить симулятор чужого БПЛА"/>
  <arg name="simulate_drone" default="true" doc="Запустить симулятор дрона (публикация позиции)"/>
  <arg name="auto_detect_intruder" default="false" doc="Автоматическая детекция нарушителя"/>
  <arg name="intruder_behavior" default="linear" doc="Поведение нарушителя: linear, circle, hover"/>

  <!-- Параметры патрулирования -->
  <arg name="patrol_radius" default="50.0" doc="Радиус воздушного патруля (м)"/>
  <arg name="patrol_altitude" default="10.0" doc="Высота воздушного патруля (м)"/>
  <arg name="num_waypoints" default="8" doc="Количество точек в маршруте патруля"/>

  <!-- Параметры управления дроном -->
  <arg name="target_altitude" default="10.0" doc="Целевая высота для взлёта (м)"/>
  <arg name="intercept_distance" default="2.0" doc="Дистанция успешного перехвата (м)"/>

  <!-- Параметры симулятора дрона -->
  <arg name="drone_max_speed" default="5.0" doc="Максимальная скорость симулятора дрона (м/с)"/>

  <!-- Параметры мониторинга -->
  <arg name="enable_battery_monitor" default="true" doc="Включить мониторинг батареи"/>
  <arg name="critical_battery_level" default="10.0" doc="Критический уровень батареи (%)"/>

  <!-- ============================================================ -->
  <!-- ГЛОБАЛЬНЫЕ ПАРАМЕТРЫ                                          -->
  <!-- ============================================================ -->

  <param name="robot_name" value="air_ground_security_mvp"/>
  <param name="robot_phase" value="phase_1"/>
  <param name="mission_type" value="air_space_control"/>

  <!-- ============================================================ -->
  <!-- ПАРАМЕТРЫ ДЛЯ УЗЛОВ (через <param>, НЕ <rosparam>)            -->
  <!-- В ROS 1 $(arg ...) не раскрывается внутри <rosparam> блоков! -->
  <!-- ============================================================ -->

  <!-- Параметры drone_simulator -->
  <param name="drone_simulator/max_speed" value="$(arg drone_max_speed)" type="double"/>
  <param name="drone_simulator/update_rate" value="20.0" type="double"/>
  <param name="drone_simulator/position_tolerance" value="0.1" type="double"/>
  <param name="drone_simulator/start_x" value="0.0" type="double"/>
  <param name="drone_simulator/start_y" value="0.0" type="double"/>
  <param name="drone_simulator/start_z" value="0.0" type="double"/>

  <!-- Параметры drone_controller -->
  <param name="drone_controller/target_altitude" value="$(arg target_altitude)" type="double"/>
  <param name="drone_controller/intercept_distance" value="$(arg intercept_distance)" type="double"/>
  <param name="drone_controller/altitude_tolerance" value="0.5" type="double"/>
  <param name="drone_controller/landing_tolerance" value="0.1" type="double"/>
  <param name="drone_controller/critical_battery" value="$(arg critical_battery_level)" type="double"/>

  <!-- Параметры air_patrol_planner -->
  <param name="air_patrol_planner/patrol_radius" value="$(arg patrol_radius)" type="double"/>
  <param name="air_patrol_planner/patrol_altitude" value="$(arg patrol_altitude)" type="double"/>
  <param name="air_patrol_planner/num_waypoints" value="$(arg num_waypoints)" type="int"/>
  <param name="air_patrol_planner/waypoint_tolerance" value="3.0" type="double"/>
  <param name="air_patrol_planner/center_x" value="0.0" type="double"/>
  <param name="air_patrol_planner/center_y" value="0.0" type="double"/>

  <!-- Параметры intruder_detector -->
  <param name="intruder_detector/simulation_enabled" value="$(arg auto_detect_intruder)" type="bool"/>
  <param name="intruder_detector/detection_probability" value="0.1" type="double"/>
  <param name="intruder_detector/check_interval" value="2.0" type="double"/>
  <param name="intruder_detector/intruder_radius_min" value="30.0" type="double"/>
  <param name="intruder_detector/intruder_radius_max" value="70.0" type="double"/>
  <param name="intruder_detector/intruder_altitude_min" value="5.0" type="double"/>
  <param name="intruder_detector/intruder_altitude_max" value="20.0" type="double"/>
  <param name="intruder_detector/center_x" value="0.0" type="double"/>
  <param name="intruder_detector/center_y" value="0.0" type="double"/>
  <param name="intruder_detector/alert_duration" value="2.0" type="double"/>

  <!-- Параметры intruder_simulator -->
  <param name="intruder_simulator/behavior" value="$(arg intruder_behavior)" type="str"/>
  <param name="intruder_simulator/speed" value="5.0" type="double"/>
  <param name="intruder_simulator/update_rate" value="10.0" type="double"/>
  <param name="intruder_simulator/start_x" value="100.0" type="double"/>
  <param name="intruder_simulator/start_y" value="0.0" type="double"/>
  <param name="intruder_simulator/start_z" value="15.0" type="double"/>
  <param name="intruder_simulator/target_x" value="0.0" type="double"/>
  <param name="intruder_simulator/target_y" value="0.0" type="double"/>
  <param name="intruder_simulator/target_z" value="15.0" type="double"/>
  <param name="intruder_simulator/circle_radius" value="40.0" type="double"/>
  <param name="intruder_simulator/circle_altitude" value="15.0" type="double"/>
  <param name="intruder_simulator/auto_trigger_detector" value="true" type="bool"/>

  <!-- ============================================================ -->
  <!-- УЗЛЫ СИМУЛЯЦИИ (ФАЗА 1)                                       -->
  <!-- ============================================================ -->

  <!-- Симулятор дрона (публикует /drone/position, Фаза 1) -->
  <!-- В Фазе 2 заменяется реальным драйвером дрона (mavros + PX4) -->
  <node name="drone_simulator"
        pkg="air_ground_bringup"
        type="drone_simulator.py"
        output="screen"
        respawn="false"
        if="$(arg simulate_drone)"/>

  <!-- ============================================================ -->
  <!-- УЗЛЫ УПРАВЛЕНИЯ ДРОНОМ (ЯДРО ФАЗЫ 1)                          -->
  <!-- ============================================================ -->

  <!-- Конечный автомат управления дроном -->
  <node name="drone_controller"
        pkg="air_ground_bringup"
        type="drone_controller.py"
        output="screen"
        respawn="false"/>

  <!-- Планировщик воздушного патруля -->
  <node name="air_patrol_planner"
        pkg="air_ground_bringup"
        type="air_patrol_planner.py"
        output="screen"
        respawn="false"/>

  <!-- Детектор чужих БПЛА (симуляция в Фазе 1) -->
  <node name="intruder_detector"
        pkg="air_ground_bringup"
        type="intruder_detector.py"
        output="screen"
        respawn="false"/>

  <!-- Симулятор чужого БПЛА (только если включён) -->
  <node name="intruder_simulator"
        pkg="air_ground_bringup"
        type="intruder_simulator.py"
        output="screen"
        respawn="false"
        if="$(arg simulate_intruder)"/>

  <!-- ============================================================ -->
  <!-- УЗЛЫ МОНИТОРИНГА                                              -->
  <!-- ============================================================ -->

  <!-- Мониторинг батареи ноутбука (реальное устройство) -->
  <node name="battery_node"
        pkg="air_ground_bringup"
        type="battery_node.py"
        output="screen"
        respawn="false"
        if="$(arg enable_battery_monitor)"/>

  <!-- ============================================================ -->
  <!-- ВИЗУАЛИЗАЦИЯ (по параметру, требуется по заданию)             -->
  <!-- ============================================================ -->

  <!-- RViz с предустановленной конфигурацией -->
  <node name="rviz"
        pkg="rviz"
        type="rviz"
        args="-d $(find air_ground_bringup)/config/default.rviz"
        output="screen"
        if="$(arg rviz)"/>

  <!-- RQT для мониторинга топиков и графиков -->
  <node name="rqt_gui"
        pkg="rqt_gui"
        type="rqt_gui"
        output="screen"
        if="$(arg rqt)"/>

  <!-- ============================================================ -->
  <!-- ЛОГИРОВАНИЕ ЗАПУСКА                                           -->
  <!-- ============================================================ -->

  <node name="launch_logger"
        pkg="rostopic"
        type="rostopic"
        args="pub --once /launch/status std_msgs/String 'data: Air-Ground Security MVP Phase 1 launched'"
        output="log"/>

</launch>
